<?xml version="1.0" encoding="utf-8"?>
<!--
    Landscape layout for phones: the cover fills the panel height, with the toolbar and the
    playback controls laid over its top and bottom edges. A single tap on the cover hides or
    shows the overlays. Keep in sync with layout-h360dp-land/fragment_playback_panel.xml.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/playback_pager"
        style="@style/Widget.Auxio.Image.Full"
        app:enablePlaybackIndicator="false"
        app:enableSelectionBadge="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Large" />

    <FrameLayout
        android:id="@+id/playback_overlay_top"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/spacing_large"
        app:layout_constraintEnd_toEndOf="@+id/playback_pager"
        app:layout_constraintStart_toStartOf="@+id/playback_pager"
        app:layout_constraintTop_toTopOf="@+id/playback_pager">

        <org.oxycblt.auxio.ui.AuxioToolbar
            android:id="@+id/playback_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:menu="@menu/toolbar_playback"
            app:navigationIcon="@drawable/ic_down_24" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/playback_overlay_bottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/spacing_large"
        android:paddingBottom="@dimen/spacing_small"
        app:layout_constraintBottom_toBottomOf="@+id/playback_pager"
        app:layout_constraintEnd_toEndOf="@+id/playback_pager"
        app:layout_constraintStart_toStartOf="@+id/playback_pager">

        <LinearLayout
            android:id="@+id/playback_info_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_medium"
            android:layout_marginBottom="@dimen/spacing_tiny"
            android:orientation="vertical">

            <TextView
                android:id="@+id/playback_song"
                style="@style/Widget.Auxio.TextView.Primary.Compact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fallbackLineSpacing="false"
                tools:text="Song Name" />

            <TextView
                android:id="@+id/playback_artist"
                style="@style/Widget.Auxio.TextView.Secondary.Compact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fallbackLineSpacing="false"
                tools:text="Artist Name" />

        </LinearLayout>

        <org.oxycblt.auxio.playback.ui.ForcedLTRFrameLayout
            android:id="@+id/playback_controls_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_small">

            <org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButtonGroup
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:spacing="@dimen/spacing_tiny">

                <org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButton
                    android:id="@+id/playback_repeat"
                    style="@style/Widget.Auxio.Button.Playback.Toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/desc_change_repeat"
                    app:icon="@drawable/ic_repeat_off_24"
                    app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Medium" />

                <org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButton
                    android:id="@+id/playback_skip_prev"
                    style="@style/Widget.Auxio.Button.Playback.Skip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/desc_skip_prev"
                    app:icon="@drawable/ic_skip_prev_24"
                    app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Large.Narrow" />

                <org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButton
                    android:id="@+id/playback_play_pause"
                    style="@style/Widget.Auxio.Button.Playback.PlayPause"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/desc_play_pause"
                    app:icon="@drawable/sel_playing_state_24"
                    app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Large"
                    tools:icon="@drawable/ic_play_24" />

                <org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButton
                    android:id="@+id/playback_skip_next"
                    style="@style/Widget.Auxio.Button.Playback.Skip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/desc_skip_next"
                    app:icon="@drawable/ic_skip_next_24"
                    app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Large.Narrow" />

                <org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButton
                    android:id="@+id/playback_shuffle"
                    style="@style/Widget.Auxio.Button.Playback.Toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/desc_shuffle"
                    app:icon="@drawable/sel_shuffle_state_24"
                    app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Medium"
                    app:tint="@color/sel_activatable_icon" />

            </org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButtonGroup>

        </org.oxycblt.auxio.playback.ui.ForcedLTRFrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
