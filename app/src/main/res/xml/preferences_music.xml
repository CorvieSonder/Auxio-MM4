<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    app:title="@string/set_content">
    <PreferenceCategory app:title="@string/set_music">

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="@string/set_key_observing"
            app:summary="@string/set_observing_desc"
            app:title="@string/set_observing" />

        <org.oxycblt.auxio.settings.ui.WrappedDialogPreference
            app:key="@string/set_key_separators"
            app:summary="@string/set_separators_desc"
            app:title="@string/set_separators" />

        <org.oxycblt.auxio.settings.ui.WrappedDialogPreference
            app:key="@string/set_key_custom_tags"
            app:summary="@string/set_custom_tags_desc"
            app:title="@string/lbl_custom_tags" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="@string/set_key_auto_sort_names"
            app:summary="@string/set_intelligent_sorting_desc"
            app:title="@string/set_intelligent_sorting" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="@string/set_key_multicore_loading"
            app:summary="@string/set_multicore_loading_desc"
            app:title="@string/set_multicore_loading" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="@string/set_key_hide_collaborators"
            app:summary="@string/set_hide_collaborators_desc"
            app:title="@string/set_hide_collaborators" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="@string/set_key_write_tags"
            app:summary="@string/set_write_tags_desc"
            app:title="@string/set_write_tags" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/set_ratings">

        <org.oxycblt.auxio.settings.ui.IntListPreference
            app:defaultValue="0"
            app:entries="@array/entries_rating_source"
            app:entryValues="@array/values_rating_source"
            app:key="@string/set_key_rating_source"
            app:title="@string/set_rating_source" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="@string/set_key_rating_lists"
            app:summary="@string/set_rating_lists_desc"
            app:title="@string/set_rating_lists" />

        <org.oxycblt.auxio.settings.ui.IntListPreference
            app:defaultValue="0"
            app:entries="@array/entries_rating_symbol"
            app:entryValues="@array/values_rating_symbol"
            app:key="@string/set_key_rating_symbol"
            app:title="@string/set_rating_symbol"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/set_auto_playlists">

        <MultiSelectListPreference
            app:defaultValue="@array/values_auto_playlists"
            app:entries="@array/entries_auto_playlists"
            app:entryValues="@array/values_auto_playlists"
            app:key="@string/set_key_auto_playlists"
            app:summary="@string/set_auto_playlists_shown_desc"
            app:title="@string/set_auto_playlists_shown" />

        <org.oxycblt.auxio.settings.ui.IntListPreference
            app:defaultValue="30"
            app:entries="@array/entries_auto_recent_days"
            app:entryValues="@array/values_auto_recent_days"
            app:key="@string/set_key_auto_recent_days"
            app:title="@string/set_auto_recent_days" />

        <org.oxycblt.auxio.settings.ui.IntListPreference
            app:defaultValue="8"
            app:entries="@array/entries_auto_rated_minimum"
            app:entryValues="@array/values_auto_rated_minimum"
            app:key="@string/set_key_auto_rated_minimum"
            app:title="@string/set_auto_rated_minimum" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/set_images">

        <org.oxycblt.auxio.settings.ui.IntListPreference
            app:defaultValue="@integer/cover_mode_balanced"
            app:entries="@array/entries_cover_mode"
            app:entryValues="@array/values_cover_mode"
            app:key="@string/set_key_cover_mode"
            app:title="@string/set_cover_mode" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="@string/set_key_square_covers"
            app:summary="@string/set_square_covers_desc"
            app:title="@string/set_square_covers" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/set_playlist_sync">

        <Preference
            app:key="@string/set_key_export_playlist_changes"
            app:summary="@string/set_export_playlist_changes_desc"
            app:title="@string/set_export_playlist_changes" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/set_listened">

        <Preference
            app:key="@string/set_key_export_listened"
            app:summary="@string/set_export_listened_desc"
            app:title="@string/set_export_listened" />

    </PreferenceCategory>
</PreferenceScreen>
